generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String      @id @default(cuid())
  username   String      @unique @db.VarChar(30) // lowercase
  password   String      @db.VarChar(100)        // bcrypt hash
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  tasks      Task[]
  milestones Milestone[] // Ties progress milestones to user
  createdAt  DateTime    @default(now())

  pushSubscriptions    PushSubscription[]
  notificationSettings NotificationSettings?
  notificationLogs     NotificationLog[]

  goals                Goal[]
  goalTasks            GoalTask[]
}

model Task {
  id              String   @id @default(cuid())
  userId          String   // Ties the task to the user
  user            User     @relation(fields: [userId], references: [id])
  
  rail            String   @db.VarChar(20)
  title           String   @db.VarChar(120)
  deadline        DateTime 
  importanceLevel Int      @default(3)
  lightColor      String   @db.VarChar(20)
  microStep       String   @db.VarChar(200)
  warningThresholdMin     Int      @default(120) 
  notificationIntervalMin Int?     
  status          String   @default("ACTIVE") @db.VarChar(20)
  score           String?  @db.VarChar(20)
  reflection      String?  @db.VarChar(6000)
  completedAt     String?  @db.VarChar(40)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==========================================
// PROGRESS ENGINE MODELS
// ==========================================

model Milestone {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  
  date       DateTime // Absolute date for chronological sorting
  dateString String   @db.VarChar(20) // Display string (e.g. "9/20/26")
  
  metrics    Metric[] // The points tracked on this date
  
  createdAt  DateTime @default(now())
}

model Metric {
  id          String    @id @default(cuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  
  name        String    @db.VarChar(60)
  val         Int
  
  createdAt   DateTime  @default(now())
}

// ==========================================
// GOAL MANAGEMENT MODELS
// ==========================================

// Goals form a strict tree: deleting a goal orphans its sub-goals (parentId -> null)
model Goal {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String     @db.VarChar(120)
  status    String     @default("IN_PROGRESS") @db.VarChar(20) // IN_PROGRESS | PAUSED | COMPLETED

  parentId  String?
  parent    Goal?      @relation("GoalTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Goal[]     @relation("GoalTree")

  plans     GoalPlan[]
  tasks     GoalTask[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@index([parentId])
}

model GoalPlan {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  title     String   @db.VarChar(120)
  body      String   @default("") @db.VarChar(6000) // markdown

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([goalId])
}

// A task has at most one parent goal; deleting the goal just unattaches the task
model GoalTask {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  goalId     String?
  goal       Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)

  title      String        @db.VarChar(120)
  metricType String        @db.VarChar(20) // COUNT | PERCENT | DURATION | YESNO | CUSTOM
  unit       String?       @db.VarChar(20) // label for CUSTOM metrics
  target     Float         // PERCENT = 100, YESNO = 1, DURATION in minutes
  current    Float         @default(0)

  workType     String      @default("SHALLOW") @db.VarChar(20) // DEEP | SHALLOW
  timeSpentMin Int         @default(0)         // manually logged, independent of the progress metric

  logs        GoalTaskLog[]

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([userId])
  @@index([goalId])
}

// Every value change, used for undo, sparkline and streaks
model GoalTaskLog {
  id          String   @id @default(cuid())
  goalTaskId  String
  goalTask    GoalTask @relation(fields: [goalTaskId], references: [id], onDelete: Cascade)

  delta       Float
  valueAfter  Float

  createdAt   DateTime @default(now())

  @@index([goalTaskId, createdAt])
}

// ==========================================
// NOTIFICATION SYSTEM MODELS
// ==========================================

// One row per browser/device that opted in to push
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint      String    @unique @db.VarChar(2048)
  p256dh        String    @db.VarChar(256)
  auth          String    @db.VarChar(256)
  userAgent     String?   @db.VarChar(300)

  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?

  @@index([userId])
}

model NotificationSettings {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  enabled    Boolean  @default(true)
  timezone   String   @default("UTC") @db.VarChar(64) // IANA name, e.g. "Asia/Kolkata"
  quietStart Int?     // minutes from midnight in `timezone`; null = no quiet hours
  quietEnd   Int?
  typePrefs  Json     @default("{}")   // { [type]: boolean } overrides of the registry defaults

  updatedAt  DateTime @updatedAt
}

// Outbox + idempotency record. dedupeKey is unique so a notification is never sent twice.
model NotificationLog {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String    @db.VarChar(50)
  dedupeKey String    @unique @db.VarChar(200)
  title     String    @db.VarChar(200)
  body      String    @db.VarChar(1000)
  url       String?   @db.VarChar(2048)
  data      Json?

  status    String    @default("PENDING") @db.VarChar(20) // PENDING | SENT | SKIPPED | FAILED
  attempts  Int       @default(0)
  error     String?   @db.VarChar(1000)
  sendAfter DateTime  @default(now())
  expiresAt DateTime? // after this a pending notification is dropped instead of sent late
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status, sendAfter])
  @@index([userId])
}

